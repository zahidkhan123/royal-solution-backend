# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/sportshub

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Social Auth
GOOGLE_CLIENT_ID=your-google-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Facebook token validation (optional)
# Keep OFF unless you are debugging token issues.
FACEBOOK_STRICT_VALIDATION=false
FACEBOOK_USE_APP_SECRET_PROOF=false

# Meta App Events / Conversions API (app install campaigns + CompleteRegistration)
# Dataset ID is usually the same as FACEBOOK_APP_ID for app events.
META_DATASET_ID=your-facebook-app-id
# System user access token with ads_management / business_management + events permissions
# Create under Meta Business Suite → Business Settings → System Users → Generate Token
META_ACCESS_TOKEN=your-meta-capi-access-token
# Optional: Graph API version (default v21.0)
META_GRAPH_API_VERSION=v21.0
# Optional: Events Manager → Test Events code (for debugging only; remove in production)
# META_TEST_EVENT_CODE=TEST12345

# Email (OTP) - Optional. If not set, OTP is logged to console only.
# Railway/cloud: set RESEND_API_KEY (Resend HTTPS API). SMTP is blocked on most cloud hosts.
RESEND_API_KEY=re_jVjERut2_2UNRCbDP7mzuv2xok4r8Fhtm
# Sender address. Resend: use a verified domain or onboarding@resend.dev for testing.
EMAIL_FROM=SportX <onboarding@resend.dev>

# Or use SMTP (works locally; often blocked on cloud hosts):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ZOHO_APP_PASS=your-zoho-app-password

# AWS S3 Configuration (required for /api/images/upload)
# Access Key ID starts with AKIA… (not the long secret)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-bucket-name

# Legacy aliases (optional — same values; used as fallback if AWS_* empty)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ap-south-1
S3_BUCKET=your-bucket-name

# Weather (Tomorrow.io)
TOMORROW_API_KEY=your_api_key_here
